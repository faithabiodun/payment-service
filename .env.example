# Copy to .env for local use. Never commit the real .env file.
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-local-database-password

API_CUSTOMER_USERNAME=customer
API_CUSTOMER_PASSWORD=replace-with-a-long-random-password
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=replace-with-a-different-long-random-password
API_MONITORING_USERNAME=prometheus
API_MONITORING_PASSWORD=replace-with-another-long-random-password

PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=http://localhost:8080/api/v1/payments/callback
PAYMENT_DEFAULT_PROVIDER=PAYSTACK

# Optional: fill these only when using the corresponding provider.
FLUTTERWAVE_V3_SECRET_KEY=
FLUTTERWAVE_V3_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_V4_CLIENT_ID=
FLUTTERWAVE_V4_CLIENT_SECRET=
FLUTTERWAVE_V4_WEBHOOK_SECRET_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
