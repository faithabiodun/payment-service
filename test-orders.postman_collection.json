{
  "info": {
    "name": "Payment Service - Test Payment Flow",
    "description": "Create a test order, then initialize its payment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "reference",
      "value": "PAY-YOUR-REFERENCE",
      "type": "string"
    },
    {
      "key": "amountKobo",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Test Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"faith@example.com\",\n  \"amountKobo\": 500000\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Creates an order for NGN 5,000 and saves its returned id as the collection variable orderId.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/test-orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "test-orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const order = pm.response.json();",
              "if (order.id) pm.collectionVariables.set('orderId', order.id);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Initialize Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "{{$guid}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": {{orderId}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/initialize",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "initialize"]
        },
        "description": "Run after Create Test Order. The collection automatically uses the new order ID. The response includes reference, amountKobo, status, authorizationUrl, and accessCode."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payment = pm.response.json();",
              "if (payment.reference) pm.collectionVariables.set('reference', payment.reference);",
              "if (payment.amountKobo) pm.collectionVariables.set('amountKobo', payment.amountKobo);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Verify Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/{{reference}}/verify",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "{{reference}}", "verify"]
        },
        "description": "Run after Initialize Payment completes checkout with Paystack. Uses the reference saved from the initialize response and returns the verified payment status."
      },
      "response": []
    },
    {
      "name": "Simulate Paystack Success Webhook",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-paystack-signature", "value": "" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/webhooks/paystack",
          "host": ["{{baseUrl}}"],
          "path": ["webhooks", "paystack"]
        },
        "description": "Local webhook simulation for testing only. First initialize a payment, then set the Postman environment variable paystackSecretKey to the same secret configured by PAYSTACK_SECRET_KEY. The pre-request script signs the exact request body. This does not contact Paystack or prove that a real payment occurred."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const secret = pm.environment.get('paystackSecretKey');",
              "if (!secret) throw new Error('Set the Postman environment variable paystackSecretKey to your local Paystack secret key.');",
              "const reference = pm.collectionVariables.get('reference');",
              "const amount = Number(pm.collectionVariables.get('amountKobo'));",
              "if (!reference || !Number.isSafeInteger(amount) || amount <= 0) throw new Error('Run Initialize Payment first so the collection has a valid reference and amountKobo.');",
              "const body = JSON.stringify({ event: 'charge.success', data: { id: Date.now(), status: 'success', reference, amount, currency: 'NGN', channel: 'card', fees: 0, paid_at: new Date().toISOString() } });",
              "pm.request.body.update({ mode: 'raw', raw: body });",
              "const signature = CryptoJS.HmacSHA512(body, secret).toString(CryptoJS.enc.Hex);",
              "pm.request.headers.upsert({ key: 'x-paystack-signature', value: signature });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get Payment Status",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/{{reference}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "{{reference}}"]
        },
        "description": "Check the payment status after the webhook call. A successfully processed charge.success event should show status SUCCESS."
      },
      "response": []
    }
  ]
}
