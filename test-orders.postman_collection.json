{
  "info": {
    "name": "Payment Service - API Testing",
    "description": "Exercise test-order creation, Paystack, Flutterwave or Stripe hosted checkout, provider-backed verification, signed webhook handling, refunds, and local payment status. Flutterwave and Stripe requests explicitly select their provider. Do not fake success webhooks: the application re-verifies transactions with the selected provider.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "reference",
      "value": "PAY-YOUR-REFERENCE",
      "type": "string"
    },
    {
      "key": "amountKobo",
      "value": "",
      "type": "string"
    },
    {
      "key": "refundReference",
      "value": "REF-YOUR-REFERENCE",
      "type": "string"
    },
    {
      "key": "refundStatus",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Test Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"faith@example.com\",\n  \"amountKobo\": 500000\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Creates an order for NGN 5,000 and saves its returned id as the collection variable orderId.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/test-orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "test-orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const order = pm.response.json();",
              "if (order.id) pm.collectionVariables.set('orderId', order.id);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Initialize Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "{{$guid}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": {{orderId}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/initialize",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "initialize"]
        },
        "description": "Run after Create Test Order. The collection automatically uses the new order ID. The response includes reference, amountKobo, status, authorizationUrl, and accessCode."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payment = pm.response.json();",
              "if (payment.reference) pm.collectionVariables.set('reference', payment.reference);",
              "if (payment.amountKobo) pm.collectionVariables.set('amountKobo', payment.amountKobo);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Initialize Flutterwave Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": {{orderId}},\n  \"provider\": \"FLUTTERWAVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/initialize",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments",
            "initialize"
          ]
        },
        "description": "Run after Create Test Order. Explicitly selects Flutterwave for this payment attempt. Open the returned authorizationUrl and complete the Flutterwave TEST checkout. Provider choice is persisted on this attempt."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payment = pm.response.json();",
              "if (payment.reference) pm.collectionVariables.set('reference', payment.reference);",
              "if (payment.amountKobo) pm.collectionVariables.set('amountKobo', payment.amountKobo);",
              "if (payment.authorizationUrl) pm.collectionVariables.set('authorizationUrl', payment.authorizationUrl);",
              "pm.test('Flutterwave checkout URL returned', () => pm.expect(payment.authorizationUrl).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Initialize Stripe Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": {{orderId}},\n  \"provider\": \"STRIPE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/initialize",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments",
            "initialize"
          ]
        },
        "description": "Run after Create Test Order. Explicitly selects Stripe for this attempt. Open the returned authorizationUrl and complete Stripe TEST Checkout. Requires STRIPE_SECRET_KEY in the app environment. The local order amount is authoritative."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payment = pm.response.json();",
              "if (payment.reference) pm.collectionVariables.set('reference', payment.reference);",
              "if (payment.amountKobo) pm.collectionVariables.set('amountKobo', payment.amountKobo);",
              "if (payment.authorizationUrl) pm.collectionVariables.set('authorizationUrl', payment.authorizationUrl);",
              "pm.test('Stripe Checkout URL returned', () => pm.expect(payment.authorizationUrl).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Verify Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/{{reference}}/verify",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "{{reference}}", "verify"]
        },
        "description": "After completing the selected provider checkout, verifies with the provider already saved on this payment attempt. For Flutterwave, this uses Flutterwave verification; the browser redirect itself does not settle the payment."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const result = pm.response.json();",
              "if (result.providerStatus) pm.collectionVariables.set('providerStatus', result.providerStatus);",
              "if (result.payment && result.payment.status) pm.collectionVariables.set('paymentStatus', result.payment.status);",
              "if (result.settlementApplied !== undefined) pm.collectionVariables.set('settlementApplied', String(result.settlementApplied));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Initiate Partial Refund",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "{{$guid}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amountKobo\": 125000,\n  \"reason\": \"sample partial refund\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/{{reference}}/refunds",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "{{reference}}", "refunds"]
        },
        "description": "Run only after a real checkout with the selected provider has succeeded and local payment status is SUCCESS or PARTIALLY_REFUNDED. Synthetic webhook samples do not create a provider transaction and cannot be refunded at the provider."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const refund = pm.response.json();",
              "if (refund.reference) pm.collectionVariables.set('refundReference', refund.reference);",
              "if (refund.status) pm.collectionVariables.set('refundStatus', refund.status);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Simulate Paystack Success Webhook",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-paystack-signature", "value": "" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/webhooks/paystack",
          "host": ["{{baseUrl}}"],
          "path": ["webhooks", "paystack"]
        },
        "description": "Local webhook simulation for testing only. First initialize a payment, then set the Postman environment variable paystackSecretKey to the same secret configured by PAYSTACK_SECRET_KEY. The pre-request script signs the exact request body. This does not contact Paystack or prove that a real payment occurred."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const secret = pm.environment.get('paystackSecretKey');",
              "if (!secret) throw new Error('Set the Postman environment variable paystackSecretKey to your local Paystack secret key.');",
              "const reference = pm.collectionVariables.get('reference');",
              "const amount = Number(pm.collectionVariables.get('amountKobo'));",
              "if (!reference || !Number.isSafeInteger(amount) || amount <= 0) throw new Error('Run Initialize Payment first so the collection has a valid reference and amountKobo.');",
              "const body = JSON.stringify({ event: 'charge.success', data: { id: Date.now(), status: 'success', reference, amount, currency: 'NGN', channel: 'card', fees: 0, paid_at: new Date().toISOString() } });",
              "pm.request.body.update({ mode: 'raw', raw: body });",
              "const signature = CryptoJS.HmacSHA512(body, secret).toString(CryptoJS.enc.Hex);",
              "pm.request.headers.upsert({ key: 'x-paystack-signature', value: signature });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Paystack Callback",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/callback?reference={{reference}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "callback"],
          "query": [
            { "key": "reference", "value": "{{reference}}" }
          ]
        },
        "description": "Paystack return URL endpoint. It only returns the reference and a message; it does not verify or settle the payment. Use Verify Payment to contact Paystack and update local payment state."
      },
      "response": []
    },
    {
      "name": "Get Payment Status",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/{{reference}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "{{reference}}"]
        },
        "description": "Check the local state after provider verification or after Flutterwave sends its signed webhook through the configured public URL."
      },
      "response": []
    }
  ]
}
