{
  "info": {
    "name": "Payment Service - Phase 2 End-to-End Testing",
    "description": "Active checkout providers are Paystack and Stripe. Flutterwave is decommissioned for new payment attempts; its provider identity remains for historical records. Use the companion local environment. Authenticated APIs use customer Basic credentials; refunds use admin credentials; Prometheus uses monitoring credentials. Complete hosted TEST checkout before verification/refunds. Synthetic signed webhook requests exercise authentication, durable inbox acknowledgement, deduplication, and metrics only; they must not settle payments. Non-API ledger, outbox, reconciliation, and concurrency checks are documented in docs/POSTMAN_PHASE_2_TESTING.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "reference",
      "value": "PAY-YOUR-REFERENCE",
      "type": "string"
    },
    {
      "key": "amountKobo",
      "value": "",
      "type": "string"
    },
    {
      "key": "refundReference",
      "value": "REF-YOUR-REFERENCE",
      "type": "string"
    },
    {
      "key": "refundStatus",
      "value": "",
      "type": "string"
    },
    {
      "key": "provider",
      "value": "PAYSTACK",
      "type": "string"
    },
    {
      "key": "paymentIdempotencyKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "authorizationUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentStatus",
      "value": "",
      "type": "string"
    },
    {
      "key": "settlementApplied",
      "value": "",
      "type": "string"
    },
    {
      "key": "refundIdempotencyKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "webhookSampleId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Payments and Provider Routing",
      "description": "Create one new order per provider; run checkout and verification before starting a different provider attempt.",
      "item": [
        {
          "name": "Create Test Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{orderEmail}}\",\n  \"amountKobo\": {{orderAmountKobo}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Create a fresh authoritative NGN 5,000 order. This also generates a new payment idempotency key for this order.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/test-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "test-orders"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('paymentIdempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.unset('reference');",
                  "pm.collectionVariables.unset('paymentId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order created', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "const expectedAmount = Number(pm.environment.get('orderAmountKobo') || 500000); pm.test('Order amount is authoritative minor units', () => pm.expect(order.amountKobo).to.eql(expectedAmount));",
                  "if (order.id) pm.collectionVariables.set('orderId', order.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Initialize Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{paymentIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"provider\": \"PAYSTACK\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/initialize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "initialize"
              ]
            },
            "description": "Run after Create Test Order. Provider is explicitly PAYSTACK and persisted before provider HTTP. Open authorizationUrl, finish the provider TEST checkout, then run Verify Payment."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('provider', 'PAYSTACK');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment attempt reserved and initialized', () => pm.response.to.have.status(201));",
                  "const payment = pm.response.json();",
                  "pm.test('Response uses the local order amount', () => pm.expect(payment.amountKobo).to.eql(500000));",
                  "if (payment.reference) pm.collectionVariables.set('reference', payment.reference);",
                  "if (payment.paymentId) pm.collectionVariables.set('paymentId', payment.paymentId);",
                  "if (payment.amountKobo) pm.collectionVariables.set('amountKobo', payment.amountKobo);",
                  "if (payment.authorizationUrl) pm.collectionVariables.set('authorizationUrl', payment.authorizationUrl);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Initialize Stripe Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{paymentIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"provider\": \"STRIPE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/initialize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "initialize"
              ]
            },
            "description": "Run after creating a NEW test order. Explicitly selects STRIPE; complete the hosted TEST checkout before verification. Provider choice cannot be changed on this attempt."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('provider', 'STRIPE');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('STRIPE payment initialized', () => pm.response.to.have.status(201));",
                  "const payment = pm.response.json();",
                  "if (payment.reference) pm.collectionVariables.set('reference', payment.reference);",
                  "if (payment.paymentId) pm.collectionVariables.set('paymentId', payment.paymentId);",
                  "if (payment.amountKobo) pm.collectionVariables.set('amountKobo', payment.amountKobo);",
                  "if (payment.authorizationUrl) pm.collectionVariables.set('authorizationUrl', payment.authorizationUrl);",
                  "pm.test('STRIPE hosted checkout URL returned', () => pm.expect(payment.authorizationUrl).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Replay Payment Initialization (Same Idempotency Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{paymentIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/payments/initialize",
            "description": "Send immediately after an initialize request. It reuses the exact order, provider, and local Idempotency-Key; it should return the same payment attempt/reference.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"provider\": \"{{provider}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Idempotent replay is successful', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const replay = pm.response.json();",
                  "pm.test('Replay returns the same payment reference', () => pm.expect(replay.reference).to.eql(pm.collectionVariables.get('reference')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{reference}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "{{reference}}",
                "verify"
              ]
            },
            "description": "After completing hosted TEST checkout, re-query the provider saved on this payment attempt. A redirect is not proof of payment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Provider verification returned', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "if (result.providerStatus) pm.collectionVariables.set('providerStatus', result.providerStatus);",
                  "if (result.payment && result.payment.status) pm.collectionVariables.set('paymentStatus', result.payment.status);",
                  "if (result.settlementApplied !== undefined) pm.collectionVariables.set('settlementApplied', String(result.settlementApplied));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Payment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{reference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "{{reference}}"
              ]
            },
            "description": "Read the local payment state after provider verification or durable webhook processing."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Local payment status is returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Browser Return Callback (UX Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/callback?reference={{reference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "callback"
              ],
              "query": [
                {
                  "key": "reference",
                  "value": "{{reference}}"
                }
              ]
            },
            "description": "Public browser return route. Returns the reference and explanatory message; does not verify or settle the payment.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Reject Unknown Provider (Expected 4xx)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/payments/initialize",
            "description": "Checks enum validation. No payment attempt should be created for an unsupported provider.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"provider\": \"NOT_A_PROVIDER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unsupported provider rejected', () => pm.expect(pm.response.code).to.be.oneOf([400, 422]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Refunds",
      "description": "Only for a genuinely successful payment. Refund mutation requires API_ADMIN_USERNAME/API_ADMIN_PASSWORD.",
      "item": [
        {
          "name": "Initiate Partial Refund",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{refundIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountKobo\": {{refundAmountKobo}},\n  \"reason\": \"sample partial refund\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{reference}}/refunds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "{{reference}}",
                "refunds"
              ]
            },
            "description": "ADMIN only. Run after a real provider transaction is verified SUCCESS. Sample partial refund: NGN 1,250 (125000 kobo). A fake webhook cannot create refundable provider funds.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{apiAdminUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{apiAdminPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const key = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('refundIdempotencyKey', key);",
                  "pm.request.headers.upsert({ key: 'Idempotency-Key', value: key });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refund reservation accepted', () => pm.expect([200, 201, 202]).to.include(pm.response.code));",
                  "const refund = pm.response.json();",
                  "if (refund.reference) pm.collectionVariables.set('refundReference', refund.reference);",
                  "if (refund.status) pm.collectionVariables.set('refundStatus', refund.status);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Replay Last Refund (Same Idempotency Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{refundIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/payments/{{reference}}/refunds",
            "description": "Immediately replay the last refund with the same Idempotency-Key. Expected: same refund reference, one provider-side refund.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountKobo\": {{refundAmountKobo}},\n  \"reason\": \"sample partial refund\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{apiAdminUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{apiAdminPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refund idempotency replay accepted', () => pm.expect([200, 201, 202]).to.include(pm.response.code));",
                  "const replay = pm.response.json();",
                  "pm.test('Replay returns same refund reference', () => pm.expect(replay.reference).to.eql(pm.collectionVariables.get('refundReference')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund More Than Remaining Capacity (Expected 4xx)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/payments/{{reference}}/refunds",
            "description": "Run only after the 125000-kobo partial refund has SUCCEEDED for the 500000-kobo payment. 400000 is then greater than the remaining capacity and must be rejected without calling the provider.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountKobo\": {{refundOverCapacityKobo}},\n  \"reason\": \"over remaining refundable amount test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{apiAdminUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{apiAdminPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refund exceeding remaining capacity rejected', () => pm.expect(pm.response.code).to.be.oneOf([400, 409, 422]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Webhooks and Durable Inbox",
      "description": "No API Basic auth is sent. Synthetic unknown event types validate provider signatures and inbox deduplication only. Real payment webhooks must come from a real provider transaction.",
      "item": [
        {
          "name": "Paystack - Signed No-op Inbox Event (Replay for Deduplication)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-paystack-signature",
                "value": ""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"event\":\"postman.inbox.test\",\"data\":{\"id\":\"sample\",\"status\":\"received\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/paystack",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "paystack"
              ]
            },
            "description": "Uses a correctly signed, allow-listed no-op event. It tests signature authentication, durable inbox acknowledgement, duplicate handling, and worker processing only. It cannot settle a payment. Set paystackSecretKey equal to the application PAYSTACK_SECRET_KEY. Run repeatedly or use Runner; the deterministic object/event/status deduplication key should keep one inbox effect.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get('paystackSecretKey');",
                  "if (!secret) throw new Error('Set the local Postman secret variable paystackSecretKey.');",
                  "let sampleId = pm.environment.get('webhookSampleId');",
                  "if (!sampleId) { sampleId = pm.variables.replaceIn('{{$guid}}').replaceAll('-', ''); pm.environment.set('webhookSampleId', sampleId); }",
                  "const body = JSON.stringify({ event: 'postman.inbox.test', data: { id: sampleId, status: 'received' } });",
                  "pm.request.body.update({ mode: 'raw', raw: body });",
                  "const signature = CryptoJS.HmacSHA512(body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-paystack-signature', value: signature });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signed webhook durably accepted', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Paystack - Reject Invalid Signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-paystack-signature",
                "value": "invalid-signature"
              }
            ],
            "url": "{{baseUrl}}/webhooks/paystack",
            "description": "Expected 401. Invalid signatures must be rejected before inbox insertion.",
            "body": {
              "mode": "raw",
              "raw": "{\"event\":\"postman.inbox.test\",\"data\":{\"id\":\"invalid-signature-case\",\"status\":\"received\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid Paystack signature rejected', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stripe - Signed No-op Inbox Event (Replay for Deduplication)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Stripe-Signature",
                "value": ""
              }
            ],
            "url": "{{baseUrl}}/webhooks/stripe",
            "description": "Signs the untouched raw body using the Stripe webhook signing secret. customer.created is intentionally ignored by the payment domain; this tests Stripe signature/inbox deduplication only. Use Postman Runner with 100 iterations to replay the same Stripe event ID and observe deduplication.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get('stripeWebhookSigningSecret');",
                  "if (!secret) throw new Error('Set stripeWebhookSigningSecret to the Stripe endpoint whsec_ signing secret (not the API key).');",
                  "let sampleId = pm.environment.get('webhookSampleId');",
                  "if (!sampleId) { sampleId = pm.variables.replaceIn('{{$guid}}').replaceAll('-', ''); pm.environment.set('webhookSampleId', sampleId); }",
                  "const timestamp = Math.floor(Date.now() / 1000);",
                  "const eventId = 'evt_postman_' + sampleId;",
                  "const body = JSON.stringify({ id: eventId, object: 'event', api_version: '2026-09-30.endive', created: timestamp, livemode: false, type: 'customer.created', data: { object: { id: 'cus_postman_sample', object: 'customer' } } });",
                  "pm.request.body.update({ mode: 'raw', raw: body });",
                  "const signature = CryptoJS.HmacSHA256(timestamp + '.' + body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'Stripe-Signature', value: 't=' + timestamp + ',v1=' + signature });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated Stripe webhook acknowledged', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stripe - Reject Invalid Signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Stripe-Signature",
                "value": "t=1,v1=bad"
              }
            ],
            "url": "{{baseUrl}}/webhooks/stripe",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"id\":\"evt_invalid\",\"object\":\"event\",\"type\":\"customer.created\",\"data\":{\"object\":{\"id\":\"cus_invalid\",\"object\":\"customer\"}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid Stripe signature rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
